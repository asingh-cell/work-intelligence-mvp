# Slack app (Work Intelligence Assistant) — from api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Shared secret you put in the Postman request header X-Trigger-Secret
TRIGGER_SHARED_SECRET=...

# Jira Cloud
JIRA_SITE=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=...

# Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Comma-separated Jira ticket keys Claude is allowed to match Slack chatter to.
ALLOWED_TICKET_KEYS=AISD2026-49,AISD2026-50,AISD2026-51

# Comma-separated Slack channel IDs to scan for evidence of work
SLACK_EVIDENCE_CHANNELS=C0123ABCD,C0456EFGH

# Optional JSON map of channel id -> likely ticket prefix
SLACK_CHANNEL_TICKET_MAP={}

# Confidence % (0-100) at/above which an item shows a green dot
AUTO_WRITE_THRESHOLD=70

PORT=5000
